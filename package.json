{
  "name": "film-spot",
  "version": "1.0.0",
  "description": "Backend for Movie Tracker App",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "server": "nodemon index.js",
    "client": "cd frontend && npm start",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
